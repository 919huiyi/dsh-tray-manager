{
  "name": "dsh-tray-manager",
  "version": "1.0.0",
  "description": "Tray & launcher manager for DeepSeek Harness (dsh): manage the PowerShell tray launcher from the dsh web UI — status, start/stop, log tail, desktop shortcut. DeepSeek Harness 托盘管理器：在 dsh web 内管理托盘启动器（状态/启停/日志/桌面快捷方式）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "tray",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "compile:tray": "node scripts/compile-tray.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "tray",
    "launcher",
    "cordis"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
